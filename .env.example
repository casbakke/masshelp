# Copy to .env and fill in. Never commit .env.

# Claude
ANTHROPIC_API_KEY=
MASSHELP_MODEL=claude-haiku-5-5
# Optional: a stronger model for document photos only, e.g. claude-sonnet-5-5
MASSHELP_HEAVY_MODEL=

# Twilio (SMS/MMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Only set to false for local tests. Production webhooks must validate signatures.
TWILIO_VALIDATE=true
# Attach the PDF as MMS media in the confirmation text (link is always included)
TWILIO_SEND_PDF_MEDIA=false

# Vapi (voice). Value Vapi sends in the Authorization header (Bearer <secret>).
VAPI_SECRET=
# Caller number to use for Vapi dashboard/web test calls that have no phone number
VAPI_DEFAULT_PHONE=

# Public URL (ngrok or Cloudflare Tunnel) used for PDF links and Twilio signature checks
PUBLIC_BASE_URL=http://localhost:8000

# Defaults to sqlite in ./data
DATABASE_URL=

# Demo controls
DEMO_TODAY=2026-12-01
# Force the form tool to return this file instead of generating one
DEMO_FIXED_PDF=

# Seed phone numbers for demo members (use the team's real phones for the live demo)
DEMO_PHONE_MARIA=+16175550101
DEMO_PHONE_CARLOS=+16175550102
DEMO_PHONE_ANA=+16175550103
DEMO_PHONE_JAMAL=+16175550104
DEMO_PHONE_LINH=+16175550105
DEMO_PHONE_DAVID=+16175550106
